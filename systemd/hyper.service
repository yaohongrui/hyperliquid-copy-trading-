[Unit]
Description=Hyperliquid copy-trading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yhr/hyper
UMask=0077
ExecStartPre=/home/yhr/hyper/.venv/bin/python /home/yhr/hyper/validate.py /home/yhr/hyper/config/config.yaml
ExecStart=/home/yhr/hyper/.venv/bin/python /home/yhr/hyper/main.py --config /home/yhr/hyper/config/config.yaml
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Restart behavior and OOMScoreAdjust belong in a drop-in
# (e.g. hyper.service.d/*.conf), not in this unit file.

[Install]
WantedBy=multi-user.target
