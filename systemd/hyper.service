[Unit]
Description=Hyperliquid copy-trading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yhr/hyper
UMask=0077
ExecStartPre=/home/yhr/hyper/.venv/bin/python /home/yhr/hyper/validate.py /home/yhr/hyper/config/config.yaml
ExecStart=/home/yhr/hyper/.venv/bin/python /home/yhr/hyper/main.py --config /home/yhr/hyper/config/config.yaml
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# The live deployment keeps a drop-in
# (copy.service.d/*.conf) that sets Restart=always and OOMScoreAdjust;
# do not remove it when updating this unit.

[Install]
WantedBy=multi-user.target
