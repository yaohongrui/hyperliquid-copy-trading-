[Unit]
Description=HL simplified copy-trading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/hyper
UMask=0077
ExecStartPre=/usr/bin/python3 /root/hyper/validate.py /root/hyper/config/config.yaml
ExecStart=/usr/bin/python3 /root/hyper/main.py --config /root/hyper/config/config.yaml
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
